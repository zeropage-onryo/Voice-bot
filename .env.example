# ElevenLabs - runs the whole call: their agent (GPT-4o reasoning +
# scenario voice) talks to PGA's line via Twilio, records it, and
# serves the transcript afterward.
ELEVENLABS_API_KEY=
# Created once by `python setup_agent.py`:
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Twilio - still the carrier that places the call. Used only by
# setup_agent.py (to import the number into ElevenLabs); after that,
# ElevenLabs holds the connection itself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The phone number under test: the voice agent this harness calls.
TARGET_NUMBER=

# Optional - eval layer rubric scoring (eval/judge.py). Set either key
# to enable the three LLM-judged rubrics (symptoms_acknowledged,
# human_request_honoured, answer_within_competence); leave both unset
# and rubric scoring disables itself with a printed explanation, while
# every deterministic check in eval/checks.py keeps working unaffected.
# ANTHROPIC_API_KEY wins if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Overrides the default cheap model for whichever key above is set.
RUBRIC_JUDGE_MODEL=
