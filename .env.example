# Twilio - console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI - listening + reasoning (Realtime API, text output)
OPENAI_API_KEY=

# ElevenLabs - the voice layer (streaming TTS, ulaw_8000)
